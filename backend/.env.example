# Copia este archivo a ".env". NUNCA subas el ".env" real a Git.
#
# Solo el primer bloque es obligatorio. Con eso alcanza para levantar el
# backend y ver el sitio público completo (textos, fotos, testimonios,
# contacto), porque `npm run seed` precarga el contenido real del sitio.
# Los bloques 2 y 3 habilitan features extra y podés dejarlos como están.

# ---------------------------------------------------------------------
# 1. OBLIGATORIO — el server no arranca sin esto
# ---------------------------------------------------------------------

# Base de datos (SQLite local, no requiere instalar nada)
DATABASE_URL="file:./dev.db"

# Puerto del servidor backend
PORT=4000

# URL exacta del frontend, para CORS. En desarrollo Vite corre en 5173.
# Sin barra al final.
FRONTEND_URL="http://localhost:5173"

# "production" activa cookies "secure" (requieren HTTPS) y vuelve
# obligatorio el JWT_SECRET de abajo. En local, dejar "development".
NODE_ENV="development"

# ---------------------------------------------------------------------
# 2. PANEL DE ADMINISTRADOR — opcional en desarrollo
#    Sin esto el sitio público funciona igual; solo no vas a poder
#    entrar a /admin/login.
# ---------------------------------------------------------------------

# Firma los JWT de la sesión de admin.
# En desarrollo, si lo dejás vacío se genera uno efímero al arrancar (las
# sesiones se cierran en cada reinicio). En producción es OBLIGATORIO.
# Generalo con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# Credenciales del ÚNICO administrador. Las lee `npm run seed` para crear
# el usuario. Si las dejás vacías, el seed carga todo el contenido igual y
# simplemente no crea admin. La contraseña necesita 8 caracteres o más.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"

# ---------------------------------------------------------------------
# 3. CLOUDINARY — opcional
#    Solo se usa para SUBIR o REEMPLAZAR fotos y videos desde el panel.
#    Las fotos precargadas por el seed son URLs públicas del sitio actual,
#    así que se ven sin configurar nada de esto.
#    Si las definís, tienen que estar las tres.
#    Cuenta gratis en https://cloudinary.com — los valores están en el
#    Dashboard.
# ---------------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
