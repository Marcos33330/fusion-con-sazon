# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real a un repositorio Git.

# Base de datos (SQLite local, no requiere instalar nada)
DATABASE_URL="file:./dev.db"

# Puerto del servidor backend
PORT=4000

# URL exacta del frontend (para CORS). En desarrollo Vite corre en 5173.
FRONTEND_URL="http://localhost:5173"

# Secreto para firmar los JWT del admin. Generalo con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cambia_esto_por_un_valor_aleatorio_largo_y_secreto"
JWT_EXPIRES_IN="8h"

# Credenciales del ÚNICO administrador (se crean con `npm run seed`)
ADMIN_EMAIL="admin@fusionconsazon.uy"
ADMIN_PASSWORD="CambiaEstaClave123!"
ADMIN_NAME="Administrador"

# Cloudinary (crea una cuenta gratis en https://cloudinary.com)
# Los 3 valores están en el Dashboard de tu cuenta de Cloudinary.
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# "production" activa cookies "secure" (requieren HTTPS). En local dejar "development".
NODE_ENV="development"
